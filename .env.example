FLASK_SECRET_KEY=replace-with-a-long-random-value
FORENSIX_DEMO_MODE=0
FLASK_SESSION_COOKIE_SECURE=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FORENSIX_PUBLIC_URL=http://127.0.0.1:5000/
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
